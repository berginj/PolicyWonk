{
  "name": "policywonk-functions",
  "version": "1.0.0",
  "description": "PolicyWonk Azure Functions Backend",
  "main": "dist/functions/**/*.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "clean": "rimraf dist",
    "prestart": "npm run clean && npm run build",
    "start": "func start",
    "dev": "npm run build && func start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@azure/functions": "^4.5.0",
    "@azure/cosmos": "^4.0.0",
    "@azure/storage-blob": "^12.17.0",
    "@azure/storage-queue": "^12.17.0",
    "@azure/search-documents": "^12.0.0",
    "@azure/ai-form-recognizer": "^5.0.0",
    "@azure/openai": "^1.0.0-beta.12",
    "@azure/communication-email": "^1.0.0",
    "@azure/identity": "^4.0.0",
    "@azure/keyvault-secrets": "^4.7.0",
    "axios": "^1.6.5",
    "cheerio": "^1.0.0-rc.12",
    "turndown": "^7.1.2",
    "readability": "@mozilla/readability@^0.5.0",
    "jsdom": "^24.0.0",
    "diff": "^5.1.0",
    "string-similarity": "^4.0.4",
    "uuid": "^9.0.1",
    "crypto": "^1.0.1",
    "date-fns": "^2.30.0",
    "date-fns-tz": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.x",
    "@types/jest": "^29.5.11",
    "@types/diff": "^5.0.9",
    "@types/uuid": "^9.0.7",
    "@types/jsdom": "^21.1.6",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "azure-functions-core-tools": "^4.x",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3",
    "prettier": "^3.2.4",
    "rimraf": "^5.0.5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
