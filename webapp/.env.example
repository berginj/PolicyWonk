# PolicyWonk Webapp Environment Variables
# Copy this file to .env.local and update values for your environment

# API Base URL (for production deployment)
# Leave empty to use proxy in development (configured in vite.config.ts)
VITE_API_BASE_URL=

# Example production values:
# VITE_API_BASE_URL=https://your-function-app.azurewebsites.net/api
